---
import type { FlowGraph } from "../data/projects";

type Props = Omit<FlowGraph, "kind">;
const { caption, columns, highlight } = Astro.props;
---

<figure class="w-full flex-1 flex flex-col font-mono text-[11px]">
  <figcaption class="text-muted uppercase tracking-widest text-[10px] mb-5">
    {caption}
  </figcaption>
  <div class="flex-1 grid gap-2 sm:grid-cols-[1fr_auto_1fr_auto_1fr] sm:items-center">
    {
      columns.map((col, i) => (
        <>
          {i > 0 && (
            <span aria-hidden="true" class="text-muted text-center">
              <span class="sm:hidden">↓</span>
              <span class="hidden sm:inline">→</span>
            </span>
          )}
          <ul class="flex flex-col gap-2">
            {col.map((box) => (
              <li
                class:list={[
                  "border bg-canvas text-text rounded px-2.5 py-2 text-center leading-snug",
                  box === highlight ? "border-text" : "border-line",
                ]}
              >
                {box}
              </li>
            ))}
          </ul>
        </>
      ))
    }
  </div>
</figure>
