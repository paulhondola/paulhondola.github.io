---
import { email, socials, cvHref } from "../data/site";
---

<section id="contact" class="max-w-6xl mx-auto px-4 sm:px-6 pt-24 pb-16">
  <p class="font-mono text-xs text-muted">
    <span class="text-signal" aria-hidden="true">●</span> /contact
  </p>
  <h2
    data-split
    class="mt-3 text-4xl sm:text-6xl max-w-4xl leading-[1.02] tracking-[-0.03em]"
  >
    Got a slow system or a hard argument? Let's talk.
  </h2>
  <a
    href={`mailto:${email}`}
    class="inline-block mt-10 font-mono text-xl sm:text-3xl text-text underline decoration-line underline-offset-8 hover:decoration-text transition-colors break-all"
    >{email}</a
  >
  <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 font-mono text-sm">
    {
      socials
        .filter((s) => s.label !== "Email")
        .map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              class="text-body hover:text-text transition-colors"
            >
              {s.label} ↗
            </a>
          </li>
        ))
    }
    <li>
      <a href={cvHref} class="text-body hover:text-text transition-colors"
        >CV ↓</a
      >
    </li>
  </ul>
</section>
