---
import RuntimeFigure from "./RuntimeFigure.astro";
import { experiences } from "../data/experiences";
---

<section id="experience" class="max-w-6xl mx-auto px-4 sm:px-6 py-24">
  <p class="font-mono text-xs text-muted">
    <span class="text-signal" aria-hidden="true">●</span> /experience
  </p>
  <h2 data-split class="mt-3 text-4xl sm:text-5xl">Experience</h2>

  <ol class="mt-12 border-t border-line">
    {
      experiences.map((e) => (
        <li class="grid md:grid-cols-[10rem_1fr] gap-x-8 gap-y-3 py-8 border-b border-line">
          <p class="font-mono text-xs text-muted pt-1.5">{e.period}</p>
          <div>
            <h3 data-split class="text-2xl">
              {e.role} <span class="text-muted font-normal">· {e.company}</span>
            </h3>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {e.stack.map((t) => (
                <li class="font-mono text-label border border-line rounded px-2 py-0.5 text-body">
                  {t}
                </li>
              ))}
            </ul>
            <ul class="mt-5 flex flex-col gap-3 max-w-xl">
              {e.points.map((pt) => (
                <li class="text-body leading-relaxed text-pretty pl-4 border-l border-line">
                  {pt}
                </li>
              ))}
            </ul>
            {e.runtime && (
              <div class="mt-6 max-w-xl">
                <RuntimeFigure />
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>
