---
import { skillGroups } from "../data/skills";
---

<section id="stack" class="max-w-6xl mx-auto px-4 sm:px-6 py-24">
  <p class="font-mono text-xs text-muted">
    <span class="text-signal" aria-hidden="true">●</span> /stack
  </p>
  <h2 data-split class="mt-3 text-4xl sm:text-5xl">Stack</h2>

  <div
    class="mt-12 grid grid-cols-2 lg:grid-cols-6 gap-x-6 gap-y-10 font-mono text-sm"
  >
    {
      skillGroups.map((g) => (
        <div>
          <h3 class="text-[11px] uppercase tracking-widest text-muted font-normal pb-3 mb-3 border-b border-line">
            {g.title}
          </h3>
          <ul class="flex flex-col gap-1.5 text-body">
            {g.items.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
