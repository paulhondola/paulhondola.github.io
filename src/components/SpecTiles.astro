---
import type { SpecsGraph } from "../data/projects";

type Props = Omit<SpecsGraph, "kind">;
const { caption, specs } = Astro.props;
---

<figure class="w-full flex-1 flex flex-col font-mono">
  <figcaption class="text-muted uppercase tracking-widest text-[10px] mb-5">
    {caption}
  </figcaption>
  <dl class="flex-1 grid grid-cols-2 content-center gap-2.5">
    {
      specs.map((s) => (
        <div class="flex flex-col-reverse justify-end border border-line bg-canvas rounded-md p-3.5">
          <dt class="text-[11px] text-muted leading-relaxed mt-1">{s.label}</dt>
          <dd class="text-xl text-text">{s.value}</dd>
        </div>
      ))
    }
  </dl>
</figure>
