---
import type { Tile } from "../data/projects";

interface Props {
  tiles: Tile[];
}
const { tiles } = Astro.props;
---

<dl class="grid grid-cols-2 md:grid-cols-4 gap-px bg-line border-t border-line">
  {
    tiles.map((t) => (
      <div class="flex flex-col-reverse justify-end bg-surface px-5 py-4">
        <dt class="text-label text-muted leading-relaxed mt-1.5">{t.label}</dt>
        <dd
          class:list={[
            "font-mono text-xl leading-tight",
            t.measured ? "text-signal" : "text-text",
          ]}
        >
          {t.value}
        </dd>
      </div>
    ))
  }
</dl>
