---
import ProjectCard from "./ProjectCard.astro";
import { projects, archive } from "../data/projects";
---

<section id="work" class="max-w-6xl mx-auto px-4 sm:px-6 py-24">
  <p class="font-mono text-xs text-muted">
    <span class="text-signal" aria-hidden="true">●</span> /work · {
      projects.length
    } projects
  </p>
  <h2 data-split class="mt-3 text-4xl sm:text-5xl">Work</h2>

  <div class="mt-12 flex flex-col gap-6">
    {
      projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))
    }
  </div>

  <h3 class="mt-20 font-mono text-xs uppercase tracking-widest text-muted">
    Also on GitHub
  </h3>
  <ul class="mt-4 border-t border-line font-mono text-sm">
    {
      archive.map((a) => (
        <li class="border-b border-line">
          <a
            href={a.href}
            target="_blank"
            rel="noopener"
            class="group flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 py-4 hover:bg-surface transition-colors px-2 -mx-2"
          >
            <span class="text-text sm:w-64 shrink-0 group-hover:text-signal transition-colors">
              {a.title} ↗
            </span>
            <span class="text-body">{a.description}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
