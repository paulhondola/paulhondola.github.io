---
import { navLinks, cvHref, availability } from "../data/site";
---

<header
  data-nav
  class="sticky top-0 z-50 bg-canvas/85 backdrop-blur-sm border-b border-line font-mono text-xs"
>
  <nav
    class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-4"
    aria-label="Main"
  >
    <a href="#main" class="text-text">paul@hondola</a>

    <ul class="hidden md:flex gap-6">
      {
        navLinks.map((l) => (
          <li>
            <a
              href={l.href}
              class="text-muted hover:text-text transition-colors"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden md:flex items-center gap-5">
      <span class="text-muted">
        <span class="text-signal mr-1" aria-hidden="true">●</span>
        {availability}
      </span>
      <a href={cvHref} class="text-text hover:text-signal transition-colors"
        >CV ↓</a
      >
    </div>

    <details class="md:hidden relative" data-menu>
      <summary
        class="list-none cursor-pointer text-text px-2 py-1 border border-line rounded"
      >
        menu
      </summary>
      <div
        class="absolute right-0 mt-3 w-64 bg-surface border border-line rounded p-4 flex flex-col gap-3"
      >
        {
          navLinks.map((l) => (
            <a href={l.href} class="text-body hover:text-text">
              {l.label}
            </a>
          ))
        }
        <a href={cvHref} class="text-text">CV ↓</a>
        <span class="text-muted pt-2 border-t border-line">
          <span class="text-signal mr-1" aria-hidden="true">●</span>
          {availability}
        </span>
      </div>
    </details>
  </nav>
</header>

<script is:inline>
  document
    .querySelectorAll("[data-menu] a")
    .forEach((a) =>
      a.addEventListener("click", () =>
        a.closest("details").removeAttribute("open"),
      ),
    );
</script>
