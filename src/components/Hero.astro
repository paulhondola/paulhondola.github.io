---
import RuntimeChart from "./RuntimeChart.astro";
import { runtime, changes } from "../data/hero";
import { cvHref } from "../data/site";
---

<section id="hero" class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 pb-20 lg:pt-24">
  <div class="grid lg:grid-cols-[1.1fr_1fr] gap-12 lg:gap-16 items-center">
    <div>
      <p class="font-mono text-xs text-muted">
        Timișoara, RO · Computer Engineering @ UPT · GPA 9.72/10
      </p>
      <h1
        data-split
        class="mt-6 text-5xl sm:text-6xl lg:text-7xl leading-[0.95] tracking-[-0.03em]"
      >
        Backend &amp; cloud engineer who profiles first.
      </h1>
      <p class="mt-6 text-lg text-body max-w-md">
        I take systems apart, measure where the time goes, and put them back
        together faster.
      </p>
      <div class="mt-8 flex flex-wrap gap-3 font-mono text-sm">
        <a
          href="#work"
          class="bg-text text-base px-5 py-3 rounded hover:bg-white transition-colors"
          >See the work</a
        >
        <a
          href={cvHref}
          class="border border-line text-text px-5 py-3 rounded hover:border-muted transition-colors"
          >Download CV ↓</a
        >
      </div>
    </div>

    <figure class="bg-surface border border-line rounded-lg p-5 sm:p-6">
      <figcaption
        class="flex justify-between font-mono text-[11px] text-muted mb-4"
      >
        <span>trace · nokia/finance-pipeline</span>
        <span>runtime</span>
      </figcaption>
      <RuntimeChart points={runtime} />
      <p class="font-mono text-sm text-signal mt-2">
        ~18× faster · now runs every 2 h
      </p>
      <ul
        class="mt-5 border-t border-line pt-4 flex flex-col gap-1 font-mono text-xs"
      >
        {
          changes.map((c) => (
            <li
              tabindex="0"
              class="flex flex-wrap gap-x-2 px-2 py-1.5 -mx-2 rounded hover:bg-base focus:bg-base"
            >
              <span class="text-muted">{c.from}</span>
              <span class="text-muted" aria-hidden="true">
                →
              </span>
              <span class="text-text">{c.to}</span>
            </li>
          ))
        }
      </ul>
    </figure>
  </div>
</section>
