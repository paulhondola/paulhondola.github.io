---
import { ladder } from "../data/hero";
import { cvHref } from "../data/site";
---

<section id="hero" class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 pb-20 lg:pt-24">
  <div class="grid lg:grid-cols-[1.1fr_1fr] gap-12 lg:gap-16 items-center">
    <div>
      <p class="font-mono text-xs text-muted">
        Timișoara, RO · Computer Engineering @ UPT · GPA 9.72/10
      </p>
      <h1
        data-split
        class="mt-6 text-5xl sm:text-6xl lg:text-7xl leading-[0.95] tracking-[-0.03em]"
      >
        From metal to cloud.
      </h1>
      <p class="mt-6 text-lg text-body max-w-md">
        I like building complex things, and I like taking them apart even more:
        to find where they're slow and put them back together better.
      </p>
      <div class="mt-8 flex flex-wrap gap-3 font-mono text-sm">
        <a
          href="#work"
          class="bg-text text-canvas px-5 py-3 rounded hover:bg-white transition-colors"
          >See the work</a
        >
        <a
          href={cvHref}
          class="border border-line text-text px-5 py-3 rounded hover:border-muted transition-colors"
          >Download CV ↓</a
        >
      </div>
    </div>

    <div class="bg-surface border border-line rounded-lg p-5 sm:p-6">
      <p class="flex justify-between font-mono text-[11px] text-muted mb-4">
        <span>stack · where I've worked</span>
        <span>proof</span>
      </p>
      <ol data-ladder class="flex flex-col">
        {
          ladder.map((r) => (
            <li class="grid grid-cols-[5.5rem_1fr_auto] items-baseline gap-x-4 py-3 border-t border-line first:border-t-0">
              <span class="font-mono text-[10px] uppercase tracking-widest text-muted">
                {r.layer}
              </span>
              <span class="text-text text-sm">{r.what}</span>
              <span
                class:list={[
                  "font-mono text-sm text-right whitespace-nowrap",
                  r.measured ? "text-signal" : "text-text",
                ]}
              >
                {r.proof}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
