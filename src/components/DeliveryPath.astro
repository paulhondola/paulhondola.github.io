---
interface Props {
  caption: string;
  steps: string[];
}
const { caption, steps } = Astro.props;
---

<figure class="w-full font-mono text-xs">
  <figcaption class="text-muted uppercase tracking-widest text-[10px] mb-5">
    delivery path
  </figcaption>
  <ol class="flex flex-wrap items-center gap-2">
    {
      steps.map((s, i) => (
        <li class="flex items-center gap-2">
          <span class="border border-line bg-canvas text-text rounded px-2.5 py-1.5">
            {s}
          </span>
          {i < steps.length - 1 && (
            <span class="text-muted" aria-hidden="true">
              →
            </span>
          )}
        </li>
      ))
    }
  </ol>
  <p class="text-signal mt-5">{caption}</p>
</figure>
