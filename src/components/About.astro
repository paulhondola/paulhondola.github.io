---
import { Image } from "astro:assets";
import paul from "../assets/paul.png";
import { availability } from "../data/site";
---

<section id="about" class="max-w-6xl mx-auto px-4 sm:px-6 py-24">
  <div class="grid md:grid-cols-[240px_1fr] gap-10 items-start">
    <Image
      src={paul}
      alt="Paul Hondola"
      widths={[240, 480]}
      sizes="240px"
      class="w-40 md:w-60 h-auto rounded-lg border border-line grayscale-[30%]"
    />
    <div>
      <p class="font-mono text-xs text-muted">
        <span class="text-signal" aria-hidden="true">●</span> /about
      </p>
      <h2 data-split class="mt-3 text-4xl sm:text-5xl">About</h2>
      <p class="mt-6 text-lg text-text max-w-2xl">
        BSc Computer Engineering at Universitatea Politehnica Timișoara (UPT),
        Oct 2023 – Jul 2027 (expected). GPA 9.72/10.
      </p>
      <p class="mt-4 text-body max-w-2xl leading-relaxed">
        Relevant coursework: Data Structures and Algorithms, Parallel and
        Distributed Algorithms, Operating Systems, Computer Architecture, Formal
        Languages and Compilation Techniques, Software Architecture, Networking,
        Databases.
      </p>
      <p class="mt-6 font-mono text-sm text-text">
        <span class="text-signal mr-1" aria-hidden="true">●</span>
        {availability}
      </p>
    </div>
  </div>
</section>
