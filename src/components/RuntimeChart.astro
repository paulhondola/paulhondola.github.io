---
interface Props {
  points: { label: string; minutes: number; display: string }[];
}
const { points } = Astro.props;

// Plot area inside a 400×220 viewBox.
const left = 44;
const right = 380;
const top = 30;
const bottom = 180;
const maxMinutes = 150;
const x = (i: number) => left + (i * (right - left)) / (points.length - 1);
const y = (m: number) => bottom - (m / maxMinutes) * (bottom - top);
const line = points.map((p, i) => `${x(i)},${y(p.minutes)}`).join(" ");
const grid = [0, 60, 120];
const mid = (i: number) => i > 0 && i < points.length - 1;
// Text sits in viewBox units, so it shrinks with the chart. Phones get bigger
// units to land at ≥11px rendered; from sm the chart is full size (~526px).
const axis = "fill-muted text-[15px] min-[480px]:text-[12px] sm:text-[9px]";
const value = "fill-text text-[15px] min-[480px]:text-[13px] sm:text-[11px]";
---

<svg
  viewBox="0 0 400 220"
  role="img"
  aria-labelledby="runtime-title"
  class="w-full h-auto font-mono"
>
  <title id="runtime-title">
    Nokia finance pipeline runtime: 2h 30 to 8 min, ~18× faster
  </title>
  {
    grid.map((m) => (
      <g>
        <line
          x1={left}
          x2={right}
          y1={y(m)}
          y2={y(m)}
          class="stroke-line"
          stroke-width="1"
        />
        <text
          x={left - 8}
          y={y(m)}
          text-anchor="end"
          dominant-baseline="central"
          class={axis}
        >
          {m === 0 ? "0" : `${m / 60}h`}
        </text>
      </g>
    ))
  }
  <polyline
    data-draw
    points={line}
    fill="none"
    class="stroke-signal"
    stroke-width="2"
    stroke-linejoin="round"></polyline>
  {
    points.map((p, i) => (
      <g>
        <circle cx={x(i)} cy={y(p.minutes)} r="3.5" class="fill-signal" />
        {/* Middle labels sit higher and to the right of their point, clear of
            the falling line and staggered against the last label. */}
        <text
          x={mid(i) ? x(i) + 6 : x(i)}
          y={y(p.minutes) - (mid(i) ? 14 : 10)}
          text-anchor={i === points.length - 1 ? "end" : "start"}
          class={value}
        >
          {p.display}
        </text>
        {p.label && (
          <text
            x={x(i)}
            y={bottom + 22}
            text-anchor={i === 0 ? "start" : "end"}
            class={`${axis} uppercase tracking-widest`}
          >
            {p.label}
          </text>
        )}
      </g>
    ))
  }
</svg>
