---
interface Props {
  points: { label: string; minutes: number; display: string }[];
}
const { points } = Astro.props;

// Plot area inside a 400×220 viewBox.
const left = 44;
const right = 380;
const top = 24;
const bottom = 180;
const maxMinutes = 150;
const x = (i: number) => left + (i * (right - left)) / (points.length - 1);
const y = (m: number) => bottom - (m / maxMinutes) * (bottom - top);
const line = points.map((p, i) => `${x(i)},${y(p.minutes)}`).join(" ");
const grid = [0, 60, 120];
---

<svg
  viewBox="0 0 400 220"
  role="img"
  aria-labelledby="runtime-title"
  class="w-full h-auto font-mono"
>
  <title id="runtime-title">
    Nokia finance pipeline runtime: 2h 30 to 8 min, ~18× faster
  </title>
  {
    grid.map((m) => (
      <g>
        <line
          x1={left}
          x2={right}
          y1={y(m)}
          y2={y(m)}
          class="stroke-line"
          stroke-width="1"
        />
        <text
          x={left - 8}
          y={y(m) + 3}
          text-anchor="end"
          class="fill-muted text-[9px]"
        >
          {m === 0 ? "0" : `${m / 60}h`}
        </text>
      </g>
    ))
  }
  <polyline
    data-draw
    points={line}
    fill="none"
    class="stroke-signal"
    stroke-width="2"
    stroke-linejoin="round"></polyline>
  {
    points.map((p, i) => (
      <g>
        <circle cx={x(i)} cy={y(p.minutes)} r="3.5" class="fill-signal" />
        <text
          x={x(i)}
          y={y(p.minutes) - 10}
          text-anchor={
            i === 0 ? "start" : i === points.length - 1 ? "end" : "middle"
          }
          class="fill-text text-[11px]"
        >
          {p.display}
        </text>
        {p.label && (
          <text
            x={x(i)}
            y={bottom + 22}
            text-anchor={i === 0 ? "start" : "end"}
            class="fill-muted text-[9px] uppercase tracking-widest"
          >
            {p.label}
          </text>
        )}
      </g>
    ))
  }
</svg>
